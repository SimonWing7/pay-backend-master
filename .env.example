APP_NAME="Edfundo Pay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# On staging/production, include slack so real errors trigger an alert —
# e.g. LOG_STACK=daily,slack. Left as file-only here since local dev
# shouldn't need a webhook configured to run at all.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Slack alerting — separate from LOG_LEVEL on purpose (see config/logging.php).
# Create an Incoming Webhook in Slack and paste its URL here to enable.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edfundo_pay
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — production uses AWS SES via SMTP. Set MAIL_MAILER=smtp and the
# MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD to the SES SMTP credentials
# (not the AWS_* keys below, which are only for the SES API/S3 driver).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Lean Open Finance — powers Edfundo Pay's merchant Pay-by-Bank checkout
# (J20, Dubai Marlins, etc.). See config/lean.php.
# --------------------------------------------------------------------------
LEAN_ENVIRONMENT=sandbox
LEAN_APP_TOKEN=
LEAN_CLIENT_SECRET=
LEAN_BASE_URL=https://sandbox.leantech.me
LEAN_AUTH_URL=https://auth.sandbox.leantech.me
LEAN_WEBHOOK_SECRET=
# Fallback payment destination used only if a merchant has no
# lean_destination_id of their own set in the admin dashboard.
LEAN_PAYMENT_DESTINATION_ID=

# --------------------------------------------------------------------------
# How long a "personal" (single-use) Draft invoice can sit unpaid before the
# invoices:expire-stale scheduled command marks it Failed. "Open" links are
# excluded — see config/invoices.php.
# --------------------------------------------------------------------------
INVOICE_EXPIRY_HOURS=24

# --------------------------------------------------------------------------
# Referral webhooks — incoming calls FROM the main Edfundo app when a
# referred user registers/subscribes/receives their reward credit.
# See app/Http/Controllers/Api/ReferralWebhookController.php.
# --------------------------------------------------------------------------
EDFUNDO_REFERRAL_SIGNING_SECRET=

# --------------------------------------------------------------------------
# NymCard Open Finance — powers the MOBILE APP's own in-app payment flow
# (AppUser purchases via InvoiceService::initiate()), separate from Lean
# and separate from the main app's card-issuing NymCard integration.
# Only needed if this server also serves mobile-app payment traffic.
# See config/nymcard.php.
# --------------------------------------------------------------------------
NYMCARD_API_KEY=
NYMCARD_BASE_URL=https://api.sandbox.nymcard.com
NYMCARD_ENVIRONMENT=sandbox
NYMCARD_WEBHOOK_SECRET=
# Set to true to skip real API calls and return mock responses.
# Defaults to true only when APP_ENV=local — must be explicitly false
# to actually call NymCard on a real staging/production server.
NYMCARD_MOCK=true
